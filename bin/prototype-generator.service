# systemd 服务单元文件
# 安装方法:
#   1. sudo cp prototype-generator.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable prototype-generator
#   4. sudo systemctl start prototype-generator
#
# 管理命令:
#   启动: sudo systemctl start prototype-generator
#   停止: sudo systemctl stop prototype-generator
#   重启: sudo systemctl restart prototype-generator
#   状态: sudo systemctl status prototype-generator
#   日志: sudo journalctl -u prototype-generator -f

[Unit]
Description=Prototype Generator - AI 驱动的高保真原型设计工具
After=network.target

[Service]
Type=simple
# 修改为你的实际部署路径
WorkingDirectory=/opt/prototype-generator
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
RestartSec=10
# 日志
StandardOutput=journal
StandardError=journal
# 安全设置
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
